<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 MSI skeleton for Jarvis (MSI/MSIX preparation).

  The primary, working installer is installer.iss (Inno Setup). This .wxs is the
  MSI track for environments that mandate MSI/MSIX (e.g. Intune deployment).

  Build (after PyInstaller produced dist\Jarvis):
    heat dir ..\..\dist\Jarvis -cg JarvisFiles -dr INSTALLFOLDER -srd -sreg -gg -var var.SourceDir -out harvest.wxs
    wix build jarvis.wxs harvest.wxs -d SourceDir=..\..\dist\Jarvis -o dist\release\Jarvis.msi

  MSIX: wrap the same dist\Jarvis payload with MakeAppx (AppxManifest.xml) or the
  MSIX Packaging Tool. User data stays in %APPDATA%\Jarvis in every case; keep the
  package payload free of writable state.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef AppVersion ?><?define AppVersion = "0.0.0" ?><?endif?>
  <Package Name="Jarvis" Manufacturer="SecondBrain" Version="$(var.AppVersion)"
           UpgradeCode="B7D6B9E4-9C2E-4A6F-9E1B-7A2A15000001" Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von Jarvis ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Jarvis" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenu" Name="Jarvis" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- File payload is harvested from dist\Jarvis into ComponentGroup "JarvisFiles". -->
    <Feature Id="Main" Title="Jarvis" Level="1">
      <ComponentGroupRef Id="JarvisFiles" />
      <ComponentRef Id="AppShortcuts" />
    </Feature>

    <Component Id="AppShortcuts" Directory="AppProgramMenu" Guid="*">
      <Shortcut Id="StartMenuJarvis" Name="Jarvis" Target="[INSTALLFOLDER]Jarvis.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="DesktopJarvis" Directory="DesktopFolder" Name="Jarvis"
                Target="[INSTALLFOLDER]Jarvis.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppProgramMenu" Directory="AppProgramMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\SecondBrain\Jarvis" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Post-install smoke test; a non-zero exit aborts the transaction. -->
    <CustomAction Id="SmokeTest" Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]jarvis-cli.exe smoke-test" Execute="deferred"
                  Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="SmokeTest" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
